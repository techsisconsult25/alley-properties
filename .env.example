# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL (used for sitemap & WhatsApp links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in international format, digits only (e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Optional marketing IDs (leave blank to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
